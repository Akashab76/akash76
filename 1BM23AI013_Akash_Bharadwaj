# # 1. Balanced Brackets

n = int(input())
l = []
for i in range(n):
    st = input()
    l.append(st)

d = {"{": "}", "[": "]", "(": ")"}
d = {"}": "{", "]": "[", ")": "("}


def isBalanced(s):
    l1 = []
    for i in s:
        if len(l1) == 0:
            l1.append(i)

        elif i == ")" or i == "]" or i == "}":
            if d[i] == l1[-1]:
                l1.pop()
            else:
                return "NO"

        else:
            l1.append(i)

    if not l1:
        return "YES"
    else:
        return "NO"


for s in l:
    print(isBalanced(s))




