# 3. Game of Two Stacks

def stack_game():
    
    s = input().split()
    n, m, maxsum = [int(i) for i in s]

    s1 = input().split()
    a = [int(i) for i in s1]

    s2 = input().split()
    b = [int(i) for i in s2]

    
    total = 0
    count = 0

     i = 0
    while i < n and total + a[i] <= maxsum:
        total += a[i]
        i += 1

    count = i  
    j = 0  

  
    while j < m and (i > 0 or total + b[j] <= maxsum):
        total += b[j]
        j += 1

        
        while total > maxsum and i > 0:
            i -= 1
            total -= a[i]

       
        if total <= maxsum:
            count = max(count, i + j)

    return count



g = int(input())
for i in range(g):
    print(stack_game())
